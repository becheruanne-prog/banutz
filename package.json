{
  "name": "spend-map",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified budgeting app for students: drop bank statements and bills, see where the money goes, plan a savings goal.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm test && npm run build",
    "serve": "python3 -m http.server 8791 --bind 127.0.0.1",
    "samples": "node scripts/gen-samples.mjs",
    "bill": "python3 scripts/make_bill.py samples/factura-energie-electrica-600-lei-DUMMY.pdf"
  },
  "engines": { "node": ">=20" }
}
